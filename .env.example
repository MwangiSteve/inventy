# =============================================================================
# Stockly Inventory Management - Environment Variables
# =============================================================================
# Copy this file to .env.local for local development.
# Never commit .env.local or .env to source control.

# =============================================================================
# DATABASE
# =============================================================================
# MongoDB connection string (required)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/stockly"

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Secret key for signing JWT tokens (required, use a strong random string)
# Generate with: openssl rand -base64 64
JWT_SECRET="your-strong-jwt-secret-at-least-32-characters-long"

# =============================================================================
# APPLICATION
# =============================================================================
# Next.js environment (development | production | test)
NODE_ENV="development"

# Application URL (required for CORS and redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# =============================================================================
# OPTIONAL: CLERK AUTHENTICATION (if using Clerk)
# =============================================================================
# CLERK_SECRET_KEY="sk_test_..."
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."

# =============================================================================
# OPTIONAL: NEXTAUTH (if using NextAuth.js)
# =============================================================================
# NEXTAUTH_SECRET="your-nextauth-secret"
# NEXTAUTH_URL="http://localhost:3000"
